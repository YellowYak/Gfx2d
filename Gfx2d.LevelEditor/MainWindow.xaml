<Window x:Name="winMainWindow" x:Class="Gfx2d.LevelEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Gfx2d.LevelEditor"
        xmlns:behaviors="clr-namespace:Gfx2d.LevelEditor.Behaviors"
        xmlns:cmd="clr-namespace:Gfx2d.LevelEditor.Commands"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1700" Height="850" 
        Closing="winMainWindow_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu x:Name="mnuMain" Grid.Row="0">
            <MenuItem x:Name="mnuMain_File" Header="_File">
                <MenuItem x:Name="mnuMain_File_New" Header="_New" Command="ApplicationCommands.New" InputGestureText="Ctrl+N">
                    <MenuItem.Icon>
                        <Grid Width="16" Height="16">
                            <Image Source="/Images/new.png"
                                   Width="12" Height="12"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                        </Grid>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="mnuMain_File_Open" Header="_Open File..." Command="ApplicationCommands.Open">
                    <MenuItem.Icon>
                        <Grid Width="16" Height="16">
                            <Image Source="/Images/open.png"
                                   Width="12" Height="12"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                        </Grid>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="mnuMain_Level_Save" Header="_Save Level" Command="ApplicationCommands.Save">
                    <MenuItem.Icon>
                        <Grid Width="16" Height="16">
                            <Image Source="/Images/save.png"
                                   Width="12" Height="12"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                        </Grid>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="mnuMain_File_SaveAs" Header="Save As..." Command="ApplicationCommands.SaveAs" />
                <Separator/>
                <MenuItem x:Name="mnuMain_File_Exit" Header="E_xit" Command="ApplicationCommands.Close" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem x:Name="mnuMain_Level" Header="_Level">
                <MenuItem x:Name="mnuMain_Level_ResizeMap" Header="Resi_ze Map..." Command="{x:Static cmd:LevelEditorCommands.ResizeMap}" InputGestureText="Ctrl+R">
                    <MenuItem.Icon>
                        <Grid Width="16" Height="16">
                            <Image Source="/Images/resize.png"
                                   Width="12" Height="12"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                        </Grid>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="mnuMain_Level_SaveAndLaunchLevel" Header="Save &amp; P_review Level" Command="{x:Static cmd:LevelEditorCommands.LaunchLevel}" InputGestureText="F5">
                    <MenuItem.Icon>
                        <Grid Width="16" Height="16">
                            <Image Source="/Images/preview.png"
                                   Width="12" Height="12"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                        </Grid>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========================= -->
            <!-- LEFT SIDE: FORM CONTROLS -->
            <!-- ========================= -->
            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <Button Content="Save &amp; Preview Level"
                            FontSize="14"
                            Width="200"
                            Command="{x:Static cmd:LevelEditorCommands.LaunchLevel}"
                            Margin="0,5,0,20"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Label Content="Name:" Width="75"/>
                        <TextBox Width="200"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Label Content="Description:" Width="75"/>
                        <TextBox Width="200"
                             Height="100"
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Label Content="Player Pos:" Width="75" VerticalAlignment="Top"/>
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Label>X:</Label>
                                <TextBox Width="75"
                                     Text="{Binding PlayerPosXText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                                <Label>, Y:</Label>
                                <TextBox Width="75"
                                     Text="{Binding PlayerPosYText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Label>Angle (rads):</Label>
                                <TextBox Width="75"
                                         Text="{Binding CameraDirectionAngleText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         ToolTip="The initial angle the player faces, in radians. A value of 0 is due east; increasing values rotate the angle clockwise."/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Label Content="Tile Size:" Width="75"/>
                        <TextBox Width="200"
                             Text="{Binding TileWidthText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Label Content="Wall Height:" Width="75"/>
                        <TextBox Width="200"
                             Text="{Binding WallHeightText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Label Content="Ceiling Clr:" Width="75"/>
                        <xctk:ColorPicker
                        Width="200"
                        ColorMode="ColorCanvas"
                        SelectedColor="{Binding CeilingColor, Mode=TwoWay}"
                    />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Label Content="Floor Clr:" Width="75"/>
                        <xctk:ColorPicker
                        Width="200"
                        ColorMode="ColorCanvas"
                        SelectedColor="{Binding FloorColor, Mode=TwoWay}"
                    />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Label Content="Map Size:" Width="75"/>
                        <Label Content="{Binding MapSize}"
                           FontWeight="Bold"
                           Margin="0,0,5,0"/>
                        <Button Content="Resize"
                                FontSize="8"
                                Padding="8,5"
                                Command="{x:Static cmd:LevelEditorCommands.ResizeMap}"
                                x:Name="btnResizeMap"
                                ToolTip="Resize the map by entering new map width and height dimensions."
                                Margin="5"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <StackPanel Orientation="Vertical">
                            <Label Content="Textures:" Width="75"/>
                            <Button Content="Add Texture"
                                Command="{x:Static cmd:LevelEditorCommands.AddTextureResource}"
                                ToolTip="Add a new texture to this level."
                                FontSize="8"
                                Margin="10,5"/>
                            <Button Content="Unselect"
                                Command="{Binding UnselectResourceReferenceCommand}"
                                CommandParameter="{Binding SelectedResourceReference}"
                                ToolTip="Unselects the map texture. Once unselected, drawing on the map will put place floors."
                                FontSize="8"
                                Margin="10,5"/>
                            <Button Content="Set Edges"
                                Command="{Binding FillEdgesWithSelectedResourceReferenceCommand}"
                                CommandParameter="{Binding SelectedResourceReference}"
                                ToolTip="Set each tile on the edge of the map with the selected texture."
                                FontSize="8"
                                Margin="10,5"/>
                        </StackPanel>

                        <ListBox ItemsSource="{Binding ResourceReferences}"
                             SelectedItem="{Binding SelectedResourceReference, Mode=TwoWay}"
                             BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding DisplayName}"
                                               VerticalAlignment="Center"/>

                                        <Button Grid.Column="1"
                                            Content="🗑"
                                            Margin="8,0,0,0"
                                            Width="22"
                                            Height="22"
                                            Focusable="False"
                                            Command="{Binding DataContext.RemoveResourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ================================ -->
            <!-- RIGHT SIDE: SCROLLABLE GRID VIEW -->
            <!-- ================================ -->
            <TabControl Grid.Column="1" 
                        Margin="10,0,0,0"
                        x:Name="tabControl">
                <!-- TAB 1: Map Editor -->
                <TabItem Header="Map Editor">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Margin="10,0,0,0">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding MapCells}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid
                                            Rows="{Binding MapHeight}"
                                            Columns="{Binding MapWidth}"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="Gray"
                                                BorderThickness="1"
                                                Background="{Binding CellBrush}"
                                                Width="{Binding DataContext.GridCellWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Height="{Binding DataContext.GridCellHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                behaviors:MapCellPaintBehavior.PaintCommand="{Binding DataContext.PaintCellCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                behaviors:MapCellPaintBehavior.EraseCellCommand="{Binding DataContext.EraseCellCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <TextBlock Text="{Binding Value}"
                                                       Foreground="{Binding TextColor}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Overlay canvas for positioning elements at arbitrary coordinates -->
                                <Canvas x:Name="MapOverlay"
                                    Width="{Binding MapPixelWidth}"
                                    Height="{Binding MapPixelHeight}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">

                                    <!-- Group the circle and arrow together -->
                                    <Grid Canvas.Left="{Binding PlayerCircleLeft}"
                                      Canvas.Top="{Binding PlayerCircleTop}"
                                      Width="15"
                                      Height="15"
                                      behaviors:DraggableBehavior.IsDraggable="True"
                                      behaviors:DraggableBehavior.CellSize="{Binding GridCellWidth}"
                                      behaviors:DraggableBehavior.UpdatePositionCommand="{Binding UpdatePlayerPositionCommand}">

                                        <Grid.RenderTransform>
                                            <TransformGroup>
                                                <!-- Rotate based on player direction (0° = facing up/north) -->
                                                <RotateTransform Angle="{Binding DataContext.CameraDirectionAngleDegrees, RelativeSource={RelativeSource AncestorType=Canvas}}" 
                                                     CenterX="7.5"
                                                     CenterY="7.5"/>

                                                <!-- Center the entire group -->
                                                <TranslateTransform X="-7.5" Y="-7.5"/>
                                            </TransformGroup>
                                        </Grid.RenderTransform>

                                        <!-- The circle -->
                                        <Ellipse Width="15"
                                             Height="15"
                                             Fill="Red"
                                             Stroke="White"
                                             StrokeThickness="2"/>
                                        <!-- The directional arrow pointing right (will be rotated) -->
                                        <Polygon Points="7.5,3 12,7.5 7.5,12 7.5,3"
                                             Fill="Yellow"
                                             Stroke="White"
                                             StrokeThickness="1"/>
                                    </Grid>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>

                        <Border Grid.Row="1"
                              Background="#F0F0F0"
                              BorderBrush="#D0D0D0"
                              BorderThickness="0,1,0,0"
                              Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding MapEditorStatusMessage}" 
                                       VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MapEditorZoomLevelDisplay}" Margin="8,0,4,0"/>
                                    <Slider Value="{Binding MapEditorZoomLevel}"
                                            Minimum="50" 
                                            Maximum="200"
                                            Width="200"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 2: Game Preview -->
                <TabItem Header="Level Preview" 
                         x:Name="tabGamePreview">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Border x:Name="gameHostBorder" 
                                Background="Black"
                                Width="1287"
                                Height="720"
                                ClipToBounds="True"
                                Visibility="Hidden">
                                <!-- HwndHost will be added programmatically -->
                            </Border>
                            <Button Content="Save &amp; Preview Level"
                                    Command="{x:Static cmd:LevelEditorCommands.LaunchLevel}"
                                    FontSize="18"
                                    x:Name="btnLaunchLevelTabButton"
                                    Padding="20,10"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>

    <Window.InputBindings>
        <KeyBinding Key="F4"
                Modifiers="Alt"
                Command="ApplicationCommands.Close"/>
        <KeyBinding Key="N"
                Modifiers="Ctrl"
                Command="ApplicationCommands.New"/>
        <KeyBinding Key="F5" 
                Command="{x:Static cmd:LevelEditorCommands.LaunchLevel}"/>
        <KeyBinding Key="R" 
                Modifiers="Ctrl"
                Command="{x:Static cmd:LevelEditorCommands.ResizeMap}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- This ListBox-related styling was taken from https://stackoverflow.com/a/57553730/160830 and is meant to keep the selected item showing the "selected" color even when the ListBox loses focus. -->
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Template">
                <!--  Revert to the "Windows 7" style template that used "SystemColors.HighlightBrushKey" etc  -->
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border
                            x:Name="ItemBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <!--  Use the same colours for selected items, whether or not the control has focus  -->
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
