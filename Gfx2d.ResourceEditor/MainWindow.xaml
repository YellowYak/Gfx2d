<Window x:Class="Gfx2d.ResourceEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Gfx2d.ResourceEditor"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu x:Name="mnuMain" Grid.Row="0">
            <MenuItem x:Name="mnuMain_File" Header="_File">
                <MenuItem x:Name="mnuMain_File_New" Header="_New" Command="ApplicationCommands.New" InputGestureText="Ctrl+N"/>
                <MenuItem x:Name="mnuMain_File_Open" Header="_Open File..." Command="ApplicationCommands.Open" />
                <MenuItem x:Name="mnuMain_File_Save" Header="_Save" Command="ApplicationCommands.Save" />
                <MenuItem x:Name="mnuMain_File_SaveAs" Header="Save As..." Command="ApplicationCommands.SaveAs" />
                <Separator/>
                <MenuItem x:Name="mnuMain_File_Exit" Header="E_xit" Command="ApplicationCommands.Close" InputGestureText="Alt+F4" />
            </MenuItem>
        </Menu>

        <!-- Main content -->
        <StackPanel Grid.Row="1" Margin="10" VerticalAlignment="Top" HorizontalAlignment="Left">
            <!-- Each field in a horizontal StackPanel -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <Label Content="Name:" Width="75" VerticalAlignment="Top"/>
                <TextBox Width="200" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <Label Content="Description:" Width="75" VerticalAlignment="Top"/>
                <TextBox Width="200" Height="100" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <Label Content="Size:" Width="75" VerticalAlignment="Top"/>
                <Label Width="200" Content="{Binding MapSize}" FontWeight="Bold" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <StackPanel Orientation="Vertical">
                    <Label Content="Resources:" Width="75" VerticalAlignment="Top"/>
                    <Button Content="Add Resource" FontSize="8" Margin="10,5"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>

    <Window.InputBindings>
        <KeyBinding Key="F4"
                Modifiers="Alt"
                Command="ApplicationCommands.Close"/>
        <KeyBinding Key="N"
                Modifiers="Ctrl"
                Command="ApplicationCommands.New"/>
    </Window.InputBindings>

</Window>
